    "quest_template": [
      {
        "ID": "40004",
        "LogTitle": "'Break the Spine'",
        "LogDescription": "'Defeat Garzareth, Karuas, Muorg and Ravathes in Gates of Valor.'",
        "QuestDescription": "'To lead his tainted forces,  the God-King has enlisted demons of great power to act as his lieutenants. If we wish to end his assault, we will need to take their leaders.\\n\\nThese demons are too powerful for most mortals to face, but with the power of Stormheim at your disposal, they will prove no match for you. \\n\\nTake them down, and shatter the spine of Skovald\\'s offensive!'",
        "StartItem": "0",
        "ItemDrop1": "0",
        "ItemDropQuantity1": "0",
        "RewardNextQuest": "0"
      },
      {
        "ID": "40003",
        "LogTitle": "'Stem the Tide'",
        "LogDescription": "'Use the Stormforged Horn to destroy the three Felbound Portals in Gates of Valor.'",
        "QuestDescription": "'Skovald has profaned the Gates of Valor with his demonic allies. Among his forces his twisted mystics have conjured portals to ferry his fel allies from their blighted worlds. \\n\\nIf we wish to stem this tide, these portals must be destroyed. \\n\\nI will gather my allies. Take this horn and signal when you have found a portal, and we will strike from the skies!'",
        "StartItem": "129161",
        "ItemDrop1": "129161",
        "ItemDropQuantity1": "1",
        "RewardNextQuest": "0"
      }
    ]
  },
