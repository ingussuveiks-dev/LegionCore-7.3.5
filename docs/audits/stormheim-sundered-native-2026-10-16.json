    "quest_template": [
      {
        "ID": "39850",
        "LogTitle": "'Sundered'",
        "LogDescription": "'Find and release the Fragment of Will, Fragment of Might, and Fragment of Valor in Helheim.'",
        "QuestDescription": "'I imagine the power of your weapon will be what allows us to defeat Geir, but right now you are too weak for the confrontation. We must reclaim the missing pieces of your spirit.\\n\\nHelya must have scattered them throughout her realm to keep them from you. If you can find them, shine the lantern and they should be set free.\\n\\nBe careful, though. It is unlikely that Helya left your spirit fragments unguarded.'",
        "Flags": "33554440",
        "FlagsEx": "0",
        "RewardNextQuest": "39853"
      }
    ],
