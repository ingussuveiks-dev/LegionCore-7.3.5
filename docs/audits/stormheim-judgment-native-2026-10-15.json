  "quests": [
    {
      "ID": "38817",
      "LogTitle": "'Regal Remains'",
      "LogDescription": "'Collect 8 Ashildir\\'s Bones in Haustvald.'",
      "QuestDescription": "'So you seek the judgment of the queen of the Valkyra? This must be your fault!\\n\\nThe Bonespeakers of Haustvald have committed an atrocity and stolen Ashildir\\'s bones. They must have done this to keep an outsider from completing the trials. You must not let this stand!\\n\\nEnter Haustvald and retrieve her remains. I hope, for your sake, that Ashildir is in a forgiving mood.'",
      "Flags": "33554440",
      "FlagsEx": "0",
      "RewardNextQuest": "38815"
    },
    {
      "ID": "38811",
      "LogTitle": "'Judgment Day'",
      "LogDescription": "'Receive judgment from the ancient vrykul rulers.'",
      "QuestDescription": "'You have proven resourceful thus far, stranger. As promised, I will instruct you on the ritual of wakening.\\n\\nFirst, you must place the offering directly atop the grave of the ruler you wish to awaken. Burn the incense so that its aroma wafts over the grave. If your offering is adequate, the ruler will rise, and you may ask your judgment.\\n\\nTake care, outsider. The dead vrykul kings will not enjoy being awakened from their slumber.'",
      "Flags": "33554440",
      "FlagsEx": "0",
      "RewardNextQuest": "38817"
    }
  ],
