  "quests": [
    {
      "ID": "38362",
      "LogTitle": "'A Grim Trophy'",
      "LogDescription": "'Take the Head of Thane Wildsky.'",
      "QuestDescription": "'It would seem Sylvanas does not wish to be followed - by us or anyone else.$B$BHer will is her own, it is not my place to question. Only to obey.$B$BIn the hills nearby, a gryphon master is preparing to take flight, no doubt to pursue our queen from the sky. My rangers are lying in wait - we need only to close our jaws around him.$B$BI will have his head when this is over.'",
      "Flags": "37748744",
      "FlagsEx": "65536",
      "RewardNextQuest": "0"
    },
    {
      "ID": "38060",
      "LogTitle": "'Signal Boost'",
      "LogDescription": "'Use the Skyfire Propeller to broadcast a distress signal, then hold out until help arrives.'",
      "QuestDescription": "'The Skyfire\\'s starboard propeller came to rest on the cliffs overlooking our camp - we\\'re gonna use it like a big antenna and push our distress signal so far that even Mekkatorque\\'s alarm clock could pick it up!$B$BUnfortunately, it might attract some unwanted attention.$B$BWe\\'re braced for enemy contact down here at the camp - fire up that signal and be ready to defend the antenna!'",
      "Flags": "172490752",
      "FlagsEx": "73728",
      "RewardNextQuest": "0"
    }
  ],
