  "quests": {
    "39776": {
      "LogTitle": "'Battle Worms'",
      "LogDescription": "'Slay Naxa, Arxas, and Xist.'",
      "QuestDescription": "'Snowmane Village behind us was caught completely off guard by the scale of this attack. I will hold the drogbar line here so the civilians have time to prepare their evacuation.$b$bThe drogbar are using worms to burrow their way to the surface and deploy their troops.$b$bI am giving you command of our forces. Use them to slay these worms and cut off enemy reinforcements.'",
      "RewardNextQuest": "42088"
    },
    "38915": {
      "LogTitle": "'Battle of Snowblind Mesa'",
      "LogDescription": "'Journey to Snowblind Mesa.'",
      "QuestDescription": "'Your timing is fortunate. Our forces at Snowblind Mesa report seeing the Underking above ground.$b$bWhat is more, he is lightly guarded, and has the hammer with him. Thanks to your efforts, we can meet them in battle.$b$bMeet us at Snowblind Mesa and let us take the fight to Dargrul together.'",
      "RewardNextQuest": "39776"
    }
  },
