        "ID": 0
      },
      "field": "Text",
      "codec": "cp1251",
      "old_hex": "",
      "new_hex": "",
      "restored_text": "Предлагаю тебе сделку: если вытащишь меня отсюда живым, получишь награду большую, чем можешь себе вообразить!",
      "broadcast": 24768,
      "context": {
        "spawn_count": "1",
        "group_rows": "1"
      }
    },
    {
