    {
      "table": "creature_text",
      "key": {
        "CreatureID": 26170,
        "GroupID": 1,
        "ID": 0
      },
      "field": "Text",
      "codec": "cp1251",
      "old_hex": "",
      "new_hex": "",
      "restored_text": "Я скорее перережу горло самому себе. Ты заплатишь за то, что сделал со своими людьми, Артас. За то, что ты сделал со мной! Клянусь!",
