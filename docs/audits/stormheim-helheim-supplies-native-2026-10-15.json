  "quest_template": [
    {
      "ID": "38347",
      "LogTitle": "'Stealth by Seaweed'",
      "LogDescription": "'Use the Kvaldir Disguise to sneak by Guarm.'",
      "QuestDescription": "'There! The disguise be complete!\\n\\nDon\\'t mind the smell, there. It\\'s probably better that we smell like the kvaldir, as well. Though I have a feeling I\\'ll be needin a priest to get this stench out once we\\'re gone.'",
      "Flags": "38797320",
      "FlagsEx": "4096",
      "AllowableRaces": "4294967295",
      "RewardNextQuest": "39848"
    },
    {
      "ID": "38339",
      "LogTitle": "'A Little Kelp From My Foes'",
      "LogDescription": "'Collect $1oa pieces of seaweed from Kvaldir Mistcallers and Soulflayers in Helheim.'",
      "QuestDescription": "'I\\'m not sure what yer doin\\' here, but ye have my thanks. If ye want to get any further, though, ye\\'ll need to get past that foul dog, Guarm.\\n\\nI\\'ve tried meself a few times, and I think I have a plan. If we can get some of the seaweed these kvaldir wear, we might be able to trick the mutt. Guarm\\'s mean, ye see, but not too smart.\\n\\nWhat do ye say? Think ye can take on a few kvaldir?'",
      "Flags": "37748744",
      "FlagsEx": "8192",
      "AllowableRaces": "4294967295",
      "RewardNextQuest": "38347"
    },
    {
      "ID": "38324",
      "LogTitle": "'Accessories of the Cursed'",
      "LogDescription": "'Collect 8 Cursed Bones in Helheim.'",
      "QuestDescription": "'Wait! Before ye go rushin\\' off, we might want to be gettin more than just seaweed. \\n\\nYe see, these vrykul also be carrying bones with them - worn all over like jewelry. If ye can get yer hands on some of the bones they got lyin around, it\\'ll add to the disguise.\\n\\nSo what ye waitin for?'",
      "Flags": "37748744",
      "FlagsEx": "8192",
      "AllowableRaces": "4294967295",
      "RewardNextQuest": "38347"
    }
  ],
