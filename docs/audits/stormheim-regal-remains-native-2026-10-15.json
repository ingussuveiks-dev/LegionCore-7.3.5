  "quests": [
    {
      "ID": "38817",
      "LogTitle": "'Regal Remains'",
      "LogDescription": "'Collect 8 Ashildir\\'s Bones in Haustvald.'",
      "QuestDescription": "'So you seek the judgment of the queen of the Valkyra? This must be your fault!\\n\\nThe Bonespeakers of Haustvald have committed an atrocity and stolen Ashildir\\'s bones. They must have done this to keep an outsider from completing the trials. You must not let this stand!\\n\\nEnter Haustvald and retrieve her remains. I hope, for your sake, that Ashildir is in a forgiving mood.'",
      "Flags": "33554440",
      "FlagsEx": "0",
      "RewardNextQuest": "38815"
    },
    {
      "ID": "38815",
      "LogTitle": "'Waking the Shieldmaiden'",
      "LogDescription": "'Use the Rune of Reformation to return Ashildir\\'s spirit to her bones.'",
      "QuestDescription": "'With the rituals disrupted and her bones returned, we may be able to wrest Ashildir from the grasp of these Bonespeakers.\\n\\nDeeper within Haustvald, the mystics possess a special altar that can reunite the body and spirit of a fallen warrior. With this, we may be able to return Ashildir\\'s spirit into her bones, and out of the grasp of these foul mystics.\\n\\nGo outsider, I will rally her guard.'",
      "Flags": "33554440",
      "FlagsEx": "0",
      "RewardNextQuest": "38818"
    }
  ],
