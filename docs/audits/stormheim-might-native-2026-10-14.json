  "quests": [
    {
      "ID": "39597",
      "LogTitle": "'The Blessing of the Watchers'",
      "LogDescription": "'Speak to Yotnar to receive the blessing of the watchers.'",
      "QuestDescription": "'As is your due for passing the Trial of Might, I will grant you the blessing of the watchers. \\n\\nFurthermore, to aid you in your trials to come, I will bestow upon your artifact the power of the vault\\'s keeper. May it serve you well in your time of need.\\n\\nSpeak to me when you are ready to receive this gift.'",
      "Flags": "39845896",
      "FlagsEx": "327680",
      "RewardNextQuest": "38473"
    },
    {
      "ID": "39594",
      "LogTitle": "'A Trial of Might'",
      "LogDescription": "'Activate the archive device to learn about the Trial of Might.'",
      "QuestDescription": "'I owe you my gratitude for helping make me whole again, outsider. It is clear that you are worthy to take on the trials. \\n\\nGo now into the vault. There you will find the archive for the first trial you must undertake.\\n\\nI will meet you inside.'",
      "Flags": "37748744",
      "FlagsEx": "65536",
      "RewardNextQuest": "39597"
    }
  ],
