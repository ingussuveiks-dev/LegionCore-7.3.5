  "quests": [
    {
      "ID": "39788",
      "LogTitle": "'The Runewood\\'s Revenge'",
      "LogDescription": "'Kill 8 Bonespeaker Runeaxes and 8 Bonespeaker Carvers in the Runewood.'",
      "QuestDescription": "'The Bonespeakers...they are corrupt... hungry for power.\\n\\nCut them from my woods...'",
      "Flags": "37748744",
      "FlagsEx": "8192",
      "RewardNextQuest": "38810"
    },
    {
      "ID": "38811",
      "LogTitle": "'Judgment Day'",
      "LogDescription": "'Receive judgment from the ancient vrykul rulers.'",
      "QuestDescription": "'You have proven resourceful thus far, stranger. As promised, I will instruct you on the ritual of wakening.\\n\\nFirst, you must place the offering directly atop the grave of the ruler you wish to awaken. Burn the incense so that its aroma wafts over the grave. If your offering is adequate, the ruler will rise, and you may ask your judgment.\\n\\nTake care, outsider. The dead vrykul kings will not enjoy being awakened from their slumber.'",
      "Flags": "33554440",
      "FlagsEx": "0",
      "RewardNextQuest": "38817"
    },
    {
      "ID": "38810",
      "LogTitle": "'The Dreaming Fungus'",
      "LogDescription": "'Collect 8 Soulcaps in the Runewood.'",
      "QuestDescription": "'So an outsider would seek to be judged by the ancient rulers of the vrykul? Curious, this. Know that they will not take to your presence kindly, stranger.\\n\\nIf you are so hasty to meet judgment, you can call them forth with a ritual of wakening. To complete this ritual, you will require an aromatic to burn and an offering to present.\\n\\nA plant grows in the Runewood that will make a suitable incense. Gather it, and I will instruct you further.'",
      "Flags": "33554440",
      "FlagsEx": "0",
      "RewardNextQuest": "38811"
    },
    {
      "ID": "38778",
      "LogTitle": "'Turn the Keys'",
      "LogDescription": "'Activate the Runestones within the Runewood.'",
      "QuestDescription": "'My roots wither... my branches die...\\n\\nThe Bonespeakers, they seek to silence the Runewood.  The runestones are the key...\\n\\nTurn the stones... release my bonds...'",
      "Flags": "39845896",
      "FlagsEx": "270336",
      "RewardNextQuest": "38810"
    }
  ],
