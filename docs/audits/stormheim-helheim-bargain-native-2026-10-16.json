  "quest_template": [
    {
      "ID": "39857",
      "LogTitle": "'The Eternal Nemesis'",
      "LogDescription": "'Return to Ashildir and inform her of Helya\\'s challenge.'",
      "QuestDescription": "'<Helya\\'s voice echoes in the sky above the altar>\\n\\nYou say that you do not belong here among the unworthy, outsider, but your spirit fragments so easily. How am I to know you speak the truth? \\n\\nI cannot, so you must show me.\\n\\nBring yourself to the eternal battlefield and face my champion. If you manage to defeat him, then I may grant you a pardon.'",
      "Flags": "33554440",
      "FlagsEx": "0",
      "RewardNextQuest": "39849"
    },
    {
      "ID": "39848",
      "LogTitle": "'A Desperate Bargain'",
      "LogDescription": "'Confront Helya and ask to be freed from Helheim.'",
      "QuestDescription": "'It looks like your friend didn\\'t make it. A pity, but we must move on.\\n\\nYou\\'ll want to plead our case to Helya. She is the ruler here. I would accompany you, but I\\'m afraid I wouldn\\'t help your case.\\n\\nMeet me when you are finished. I will see if I can find the whereabouts of my shieldmaidens.'",
      "Flags": "38797320",
      "FlagsEx": "0",
      "RewardNextQuest": "39857"
    }
  ],
