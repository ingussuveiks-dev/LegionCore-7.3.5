  "quests": [
    {
      "ID": "39597",
      "LogTitle": "'The Blessing of the Watchers'",
      "LogDescription": "'Speak to Yotnar to receive the blessing of the watchers.'",
      "QuestDescription": "'As is your due for passing the Trial of Might, I will grant you the blessing of the watchers. \\n\\nFurthermore, to aid you in your trials to come, I will bestow upon your artifact the power of the vault\\'s keeper. May it serve you well in your time of need.\\n\\nSpeak to me when you are ready to receive this gift.'",
      "Flags": "39845896",
      "FlagsEx": "327680",
      "RewardNextQuest": "38473",
      "RewardItem1": "141398",
      "RewardAmount1": "1",
      "RewardSpell": "0"
    },
    {
      "ID": "38473",
      "LogTitle": "'Will of the Thorignir'",
      "LogDescription": "'Meet with Lorna Crowley outside of Hrydshal to begin the trial of the Thorignir.'",
      "QuestDescription": "'In the summit of storms the dragons await. Born of the gods, they will test your will. \\n\\nThey roost above Hrydshal, where their children serve the Drekirjar. But they are no allies to man or vrykul, and so you must earn their blessing as they see fit.\\n\\nA friend of yours awaits in Hrydshal, no doubt searching for the answers you now possess. Go to her, and together, you will test your might against the storm!'",
      "Flags": "39845896",
      "FlagsEx": "8192",
      "RewardNextQuest": "38312",
      "RewardItem1": "0",
      "RewardAmount1": "0",
      "RewardSpell": "81040"
    }
  ],
