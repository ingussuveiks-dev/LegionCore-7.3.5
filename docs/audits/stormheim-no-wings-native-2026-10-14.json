  "quests": [
    {
      "ID": "38615",
      "LogTitle": "'Impalement Insurance'",
      "LogDescription": "'Grapple on top of the walls and dismantle 7 Tideskorn Harpoon Launchers atop in Hrydshal.'",
      "QuestDescription": "'It looks like the elements aren\\'t the only thing you\\'ll need to worry about going up that path. Those harpoon launchers on the wall look pretty nasty, and unless we take them out first, they\\'re likely to make short work of anyone trying to scale that path.\\n\\nThey\\'re up on top of the walls, so you\\'ll need to use that grapple launcher to get to them. Just try not to end up drake food!'",
      "Flags": "33685512",
      "FlagsEx": "0",
      "RewardNextQuest": "38617",
      "RewardItem1": "0",
      "RewardAmount1": "0",
      "RewardSpell": "0"
    },
    {
      "ID": "38613",
      "LogTitle": "'No Wings Required'",
      "LogDescription": "'Use the Stormforged Grapple Launcher to launch over the wall at Hrydshal.'",
      "QuestDescription": "'That thing looks like it\\'s got the range to get us over the wall. There\\'s a good spot to hook onto right past us - you should be able to spot it from here.\\n\\nOnce you\\'re inside, do me a favor and see if you can distract the guards so I can slip through. I\\'ll see what else I can find out about these vrykul.'",
      "Flags": "37748744",
      "FlagsEx": "4",
      "RewardNextQuest": "38615",
      "RewardItem1": "0",
      "RewardAmount1": "0",
      "RewardSpell": "0"
    },
    {
      "ID": "38410",
      "LogTitle": "'Impalement Insurance'",
      "LogDescription": "'Grapple on top of the walls in Hrydshal and dismantle 7 Tideskorn Harpoon Launchers.'",
      "QuestDescription": "'I\\'ve got bad news. Those harpoon launchers up on the walls might cause us some problems. \\n\\nThey can\\'t get at us down here, but once you start climbing that path, they\\'re likely going to try to skewer you.\\n\\nIf you use that grapple launcher, you should be able to get on top of the walls and dismantle them. Watch out for the drakes, though!'",
      "Flags": "33685512",
      "FlagsEx": "0",
      "RewardNextQuest": "38342",
      "RewardItem1": "0",
      "RewardAmount1": "0",
      "RewardSpell": "0"
    },
    {
      "ID": "38318",
      "LogTitle": "'No Wings Required'",
      "LogDescription": "'Go to the top of the ridge and use the Stormforged Grapple Launcher to launch over the wall at Hrydshal.'",
      "QuestDescription": "'Now that you\\'ve got the launcher, we should be able to infiltrate the city. It looks like there\\'s a good spot to grapple onto on the wall just past us. There\\'s a vantage point on top of this ridge.\\n\\nOnce we\\'re in, I\\'ll try to slip past the guards and get a look at the mountain path. I\\'d appreciate if you could make some distractions for me. If all goes well, I\\'ll meet up with you in the upper city.\\n\\nGood luck!'",
      "Flags": "37748744",
      "FlagsEx": "4",
      "RewardNextQuest": "38410",
      "RewardItem1": "0",
      "RewardAmount1": "0",
      "RewardSpell": "0"
    }
