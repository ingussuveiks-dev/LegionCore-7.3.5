    "quest_template": [
      {
        "ID": "39853",
        "LogTitle": "'Victory is Eternal'",
        "LogDescription": "'Defeat Geir in the Eternal Battlefield in Helheim.'",
        "QuestDescription": "'There is no more cause for hesitation. Now is the time to strike.\\n\\nWe will defeat this foul behemoth and meet Helya\\'s bargain. The path out of Helheim awaits, outsider. \\n\\nPrepare yourself.'",
        "Flags": "34603016",
        "FlagsEx": "0",
        "RewardNextQuest": "39855"
      },
      {
        "ID": "39851",
        "LogTitle": "'Allies in Death'",
        "LogDescription": "'Release 8 Drowning Valkyra in Helheim.'",
        "QuestDescription": "'Our power alone may not be enough to fight the behemoth, Geir. Fortunately, Faljar was kind enough to send our allies into Helheim with us.\\n\\nEarlier, I had discovered several of them being tortured by the elemental forces of Helheim. You may think the dead can\\'t drown, but with Helya\\'s power, this is not the case. \\n\\nI could not release them then, but now that you possess the waylight, you may be able to.\\n\\nSeek them out and free them from an eternity of suffering!'",
        "Flags": "33554440",
        "FlagsEx": "0",
        "RewardNextQuest": "39853"
      }
    ]
  },
