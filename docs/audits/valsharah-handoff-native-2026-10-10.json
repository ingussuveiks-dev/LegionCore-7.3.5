  "scene_name": "7.0 Val'sharah: zto - Ysera Corrupted Post-Scene - Init",
  "scene_text": "--Purpose---\r\n--[[ This scene is the follow up the cinematic where Ysera is converted to nightmare. In this scene she flies away.]]--\r\n\r\n\r\n----------\r\n-- Init --\r\n----------\r\nyseraCreatureID = 104762\r\nxaviusCreatureID = 102206\r\nmalfurionCreatureID = 100387\r\n\r\n-- ysera = SpawnSimulatedNPCActorAtPoint( yseraCreatureID, 17407, false)\r\n-- xavius = SpawnSimulatedNPCActorAtPoint( xaviusCreatureID, 17407, true)\r\n-- malfurion = SpawnSimulatedNPCActorAtPoint( malfurionCreatureID, 17407, true)\r\n\r\n--ysera = SpawnSimulatedNPCActorAtPoint( yseraCreatureID, 17542, false)\r\n--xavius = SpawnSimulatedNPCActorAtPoint( xaviusCreatureID, 17542, true)\r\n--malfurion = SpawnSimulatedNPCActorAtPoint( malfurionCreatureID, 17542, true)\r\n\r\nysera = SpawnActorAtPoint( yseraCreatureID, 17542, false)\r\nxavius = SpawnActorAtPoint( xaviusCreatureID, 17542, true)\r\nmalfurion = SpawnActorAtPoint( malfurionCreatureID, 17542, true)\r\n\r\nmalfurion:SetScale( 2 )\r\n\r\nlocal malfurionSeatOffset = Vector:New( 1, 0, -3 )\r\nlocal malfurionSeatRot = Vector:New( 0, 0, -90 )\r\n\r\nRideVehicleActor(xavius, ysera, 0, AttachmentPoint.Shield, nil, nil)\r\nRideVehicleActor(malfurion, ysera, 0, AttachmentPoint.HandLeft, malfurionSeatOffset, malfurionSeatRot)\r\n\r\nPlayLoopingSplitBodyAnim(malfurion, Animations.Drowned)\r\nPlayLoopingSplitBodyAnim(xavius, Animations.Mount)\r\n\r\nSendTrigger(\"smooth phase complete\")\r\n\r\n------------\r\n-- Action --\r\n------------\r\n--scene:ApplyScreenEffect( 1310 )\r\nWait(2)\r\n--Wait(1)\r\n--scene:ApplyScreenEffect( 0 )\r\n\r\nxavius:PlayOneShotAnimKit(6470)\r\nxavius:PlaySoundKitStereo(56314, true)\r\n\r\nWait(2)\r\n-- ysera:MoveToRel( Vector:New( 0, 0, 15 ), 3 )\r\n-- Wait(3)\r\nysera:FollowPathAtSpeed( 17408, 15, false )\r\nWait(6)\r\nscene:TriggerServerEvent( \"TYRANDE\" )\r\nWait(2)\r\nscene:EndScene()",
