  "quests": [
    {
      "ID": "39804",
      "LogTitle": "'Speaking of Bones'",
      "LogDescription": "'Help Havi butcher the moose and learn about your next trial.'",
      "QuestDescription": "'The Trial of Valor will be your next test, and test you it will!\\n\\nBut only a fool fights on an empty stomach. Are you a fool, outsider?\\n\\nNo? Then lend these old bones a hand and butcher the moose for our meal. I will spin you a tale of rocks, trees and spirits.'",
      "Flags": "37748744",
      "FlagsEx": "8192",
      "RewardNextQuest": "39796"
    },
    {
      "ID": "39803",
      "LogTitle": "'The Trials Continue'",
      "LogDescription": "'Meet with Havi in Valdisdall.'",
      "QuestDescription": "'<Havi\\'s voice continues in your head as the raven stares on>\\n\\nIf valor you seek, then to the bones you must speak! \\n\\nBut first you must prepare!'",
      "Flags": "38797320",
      "FlagsEx": "8192",
      "RewardNextQuest": "39804"
    },
    {
      "ID": "39796",
      "LogTitle": "'To Haustvald'",
      "LogDescription": "'Meet with Vydhar in the Runewood.'",
      "QuestDescription": "'Your next steps are clear, your feet know the way. Follow them to Haustvald and meet your fate!\\n\\nIt is the tree you seek, the heart of the mystic Runewood. He will offer guidance, and probably leaves.'",
      "Flags": "37748744",
      "FlagsEx": "8192",
      "RewardNextQuest": "38778"
    }
  ],
