  "quests": [
    {
      "ID": "39594",
      "LogTitle": "'A Trial of Might'",
      "LogDescription": "'Activate the archive device to learn about the Trial of Might.'",
      "QuestDescription": "'I owe you my gratitude for helping make me whole again, outsider. It is clear that you are worthy to take on the trials. \\n\\nGo now into the vault. There you will find the archive for the first trial you must undertake.\\n\\nI will meet you inside.'",
      "RewardNextQuest": "39597",
      "Flags": "37748744",
      "FlagsEx": "65536"
    },
    {
      "ID": "39593",
      "LogTitle": "'The Shattered Watcher'",
      "LogDescription": "'Collect the pieces of Yotnar\\'s body from the Terrace of the Watchers.'",
      "QuestDescription": "'When your adversary - the one called Skovald- completed his first trial, he used his ill-begotten powers to sunder my physical body.\\n\\nI cannot allow a contender to pass through the vault while I remain unwhole. \\n\\nHis forces have no doubt scattered my pieces through the plateau which they currently desecrate. Bring them back to me, so that I may properly guide your trial.'",
      "RewardNextQuest": "39594",
      "Flags": "37748744",
      "FlagsEx": "65536"
    }
  ],
