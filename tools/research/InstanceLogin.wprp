<?xml version="1.0" encoding="utf-8"?>
<WindowsPerformanceRecorder Version="1.0" Author="LegionCore">
  <Profiles>
    <SystemCollector Id="ThreadCollector" Name="Instance login thread activity">
      <BufferSize Value="512"/>
      <Buffers Value="384"/>
    </SystemCollector>
    <EventCollector Id="SocketCollector" Name="Instance login socket activity">
      <BufferSize Value="128"/>
      <Buffers Value="384"/>
    </EventCollector>
    <SystemProvider Id="ThreadActivity">
      <Keywords>
        <Keyword Value="ProcessThread"/>
        <Keyword Value="Loader"/>
        <Keyword Value="CSwitch"/>
        <Keyword Value="ReadyThread"/>
      </Keywords>
      <Stacks>
        <Stack Value="CSwitch"/>
        <Stack Value="ReadyThread"/>
      </Stacks>
    </SystemProvider>
    <EventProvider Id="SocketActivity" Name="Microsoft-Windows-Winsock-AFD" Level="5">
      <Keywords>
        <Keyword Value="0x3e"/>
      </Keywords>
      <EventFilters FilterIn="true">
        <EventId Value="1000"/> <!-- create -->
        <EventId Value="1001"/> <!-- close -->
        <EventId Value="1003"/> <!-- send -->
        <EventId Value="1004"/> <!-- receive -->
        <EventId Value="1017"/> <!-- connect result -->
        <EventId Value="1018"/> <!-- connect address -->
        <EventId Value="3003"/> <!-- transport receive indication -->
      </EventFilters>
    </EventProvider>
    <Profile Id="InstanceLogin.Verbose.Memory" Name="InstanceLogin"
             Description="Socket events and thread waits for a silent instance login"
             LoggingMode="Memory" DetailLevel="Verbose">
      <Collectors>
        <SystemCollectorId Value="ThreadCollector">
          <SystemProviderId Value="ThreadActivity"/>
        </SystemCollectorId>
        <EventCollectorId Value="SocketCollector">
          <EventProviders>
            <EventProviderId Value="SocketActivity"/>
          </EventProviders>
        </EventCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
