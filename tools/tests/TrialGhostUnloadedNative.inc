// Unload an empty bound B through the real map lifecycle. Map-level preflight
// cannot inspect B until SafeTeleport constructs it; admission then fails at ACK.
static void TrialGhostUnloadedInstance(GarmPlayer& player,InstanceMap& raid,Group& group)
{
    auto corpse=player.GetCorpse();Require(corpse&&corpse->GetInstanceId()==raid.GetInstanceId(),"Unloaded target corpse input missing");auto corpseGuid=corpse->GetGUID();auto health=player.GetHealth();
    auto home=sWorldSafeLocsStore.LookupEntry(5041);Require(home&&home->MapID==1220,"Native fallback home anchor missing");player.SetHomebind(WorldLocation(1220,home->Loc.X,home->Loc.Y,home->Loc.Z,0),7541);
    auto original=group.GetBoundInstance(raid.GetDifficultyID(),1648);Require(original&&original->save,"Unloaded target original save missing");auto originalSave=original->save;bool permanent=original->perm;
    GarmPlayer selector(*player.GetMap(),player.getRace());GarmGroup other(selector,raid.GetDifficultyID());other.group.ConvertToRaid();selector.SetRaidDifficultyID(raid.GetDifficultyID());auto target=sMapMgr->CreateMap(1648,&selector)->ToInstanceMap();Require(target&&target!=&raid,"Unloaded target native factory failed");auto targetId=target->GetInstanceId();
    auto save=sInstanceSaveMgr->AddInstanceSave(1648,targetId,raid.GetDifficultyID(),0,target->GetInstanceScript()->GetSaveData(),GameTime::GetGameTime()+WEEK,true);Require(save&&other.group.BindToInstance(save,false),"Unloaded target save retention failed");group.UnbindInstance(1648,raid.GetDifficultyID());Require(group.BindToInstance(save,false),"Unloaded target group bind failed");
    auto parent=static_cast<MapInstanced*>(sMapMgr->FindBaseMap(1648));auto iterator=parent->m_InstancedMaps.find(targetId);Require(iterator!=parent->m_InstancedMaps.end()&&parent->DestroyInstance(iterator)&&!sMapMgr->FindMap(1648,targetId),"Actual empty target unload failed");
    Require(sMapMgr->CanPlayerEnter(1648,&player,false)&&!sMapMgr->FindMap(1648,targetId)&&player.IsInWorld()&&player.isDead()&&player.GetCorpse()==corpse,"Unloaded target preflight changed ghost or constructed a map");
    auto entrance=sWorldSafeLocsStore.LookupEntry(5775);Require(entrance&&player.SafeTeleport(1648,entrance->Loc.X,entrance->Loc.Y,entrance->Loc.Z,0),"Unloaded target transfer did not start");Require(!player.IsInWorld()&&player.IsBeingTeleportedFar()&&player.GetTeleportMap()&&player.GetTeleportMap()->GetInstanceId()==targetId&&sMapMgr->FindMap(1648,targetId),"Transfer did not construct and select the unloaded target");
    player.GetSession()->HandleWorldPortAck();
    std::cout<<"GHOST_UNLOADED_FALLBACK far="<<player.IsBeingTeleportedFar()<<" near="<<player.IsBeingTeleportedNear()<<" world="<<player.IsInWorld()<<" change="<<player.IsChangeMap()<<" dest="<<player.GetTeleportDest().GetMapId()<<" corpse="<<(player.GetCorpse()!=nullptr)<<std::endl;
    Require(player.IsBeingTeleportedFar()&&!player.IsBeingTeleportedNear()&&!player.IsInWorld()&&!player.IsChangeMap()&&player.GetTeleportMap()&&player.GetTeleportMap()->GetId()==1220&&player.GetTeleportDest().GetMapId()==1220,"Rejected ACK stranded player in an out-of-world near teleport instead of a new far transfer");
    Require(player.GetTeleportDest().GetExactDist(home->Loc.X,home->Loc.Y,home->Loc.Z)<0.01f&&player.isDead()&&player.GetHealth()==health&&player.GetCorpse()==corpse,"Rejected target lost fallback coordinates or ghost/corpse");
    player.GetSession()->HandleWorldPortAck();StopGraveyardFixtureZones(*static_cast<MapInstanced*>(sMapMgr->FindBaseMap(1220)));
    Require(player.IsInWorld()&&player.GetMapId()==1220&&!player.IsBeingTeleported()&&!player.IsChangeMap()&&player.isDead()&&player.GetHealth()==health&&player.GetCorpse()==corpse&&player.GetExactDist(home->Loc.X,home->Loc.Y,home->Loc.Z)<0.01f,"Fallback ACK failed to restore the exterior ghost");
    player.GetSession()->HandleWorldPortAck();Require(player.IsInWorld()&&player.isDead()&&player.GetCorpse()==corpse,"Repeated fallback ACK consumed corpse");
    Require(player.SafeTeleport(1220,home->Loc.X+1,home->Loc.Y,home->Loc.Z,0)&&player.IsInWorld()&&player.IsBeingTeleportedNear()&&!player.IsBeingTeleportedFar(),"In-world short teleport stopped using the native near path");AckTravel(player,home->Loc.X+1,home->Loc.Y,home->Loc.Z);
    Require(player.SafeTeleport(1220,home->Loc.X,home->Loc.Y,home->Loc.Z,0)&&player.IsBeingTeleportedNear(),"In-world short return did not remain a near teleport");AckTravel(player,home->Loc.X,home->Loc.Y,home->Loc.Z);
    player.SaveToDB();FlushWrites();auto saved=CharacterDatabase.Query(Trinity::StringFormat("SELECT map,position_x,position_y,position_z,health,playerFlags FROM characters WHERE guid=%u",player.GetGUIDLow()).c_str());Require(saved&&saved->Fetch()[0].GetUInt32()==1220&&std::abs(saved->Fetch()[1].GetFloat()-home->Loc.X)<0.01f&&std::abs(saved->Fetch()[2].GetFloat()-home->Loc.Y)<0.01f&&std::abs(saved->Fetch()[3].GetFloat()-home->Loc.Z)<0.01f&&saved->Fetch()[4].GetUInt64()==health&&(saved->Fetch()[5].GetUInt32()&PLAYER_FLAGS_GHOST),"Fallback save lost home coordinates or ghost state");
    auto row=CharacterDatabase.Query(Trinity::StringFormat("SELECT corpseGuid,instanceId FROM corpse WHERE guid=%u AND corpseType<>0",player.GetGUIDLow()).c_str());Require(row&&row->GetRowCount()==1&&row->Fetch()[0].GetUInt64()==corpseGuid.GetCounter()&&row->Fetch()[1].GetUInt32()==raid.GetInstanceId(),"Fallback changed persisted original corpse");
    group.UnbindInstance(1648,raid.GetDifficultyID());Require(group.BindToInstance(originalSave,permanent),"Unloaded test original bind restore failed");raid.GetInstanceScript()->SaveToDB();Require(sMapMgr->CreateMap(1648,&player)==&raid&&raid.GetInstanceScript()->GetCompletedEncounterMask()==3,"Unloaded rejection lost original instance/progress");
    std::cout<<"PASS: native unloaded bound target, preflight, factory, rejected ACK, far fallback and second ACK, ghost/corpse SQL and original retry diff="<<uint32(raid.GetDifficultyID())<<" race="<<uint32(player.getRace())<<std::endl;
}
